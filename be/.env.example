# Port server Express (default 3000)
PORT=3000

# Connection string PostgreSQL (Supabase)
# Ambil dari: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# JWT
JWT_SECRET=ganti_dengan_secret_yang_panjang_dan_aman
JWT_EXPIRES_IN=7d

# URL publik backend, dipakai untuk membentuk URL file upload (foto, QR code, bukti bayar)
BASE_URL=http://localhost:3000

# Midtrans
MIDTRANS_SERVER_KEY=isi_server_key_midtrans
MIDTRANS_CLIENT_KEY=isi_client_key_midtrans
MIDTRANS_IS_PRODUCTION=false
