#   be/                  -> Express + PostgreSQL (Supabase)
#   fe/                  -> Next.js
#   tiket-konser-mobile/ -> Expo / React Native
# ============================================================

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/cache/
