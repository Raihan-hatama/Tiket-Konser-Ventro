# ---------- Environment variables ----------
.env
.env.local
.env.*
!.env.example

# ---------- Build output ----------
.next/
out/
dist/
build/
web-build/
coverage/
*.tsbuildinfo

# ---------- Cache & file sementara ----------
.expo/
.turbo/
.cache/
.eslintcache
.vercel/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- OS / editor ----------
.DS_Store
Thumbs.db
desktop.ini
